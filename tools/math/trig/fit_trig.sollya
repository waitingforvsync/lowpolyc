// fit_trig.sollya
//
// The four polynomials of the trig kernels (src/math/trig.h), fitted by fpminimax with double
// coefficients on [0, 0.7854], just past pi/4, relative to the function. Prints each one's
// relative error and its coefficients in hex and in decimal.
//
//   sollya fit_trig.sollya    (or: ./run.sh fits)

prec = 300;
I = [2^-40; 0.7854];
c3 = round(-1/6, D, RN);

procedure show(name, p, f) {
  var i, d;
  d = degree(p);
  print(name, "relative error 2^", log2(dirtyinfnorm((p - f) / f, I)));
  display = hexadecimal;
  for i from 0 to d do if coeff(p, i) != 0 then print("  x^", i, ":", coeff(p, i));
  display = decimal;
  for i from 0 to d do if coeff(p, i) != 0 then print("  x^", i, ":", coeff(p, i));
};

// f64 sine: x - x^3/6 (rounded) + x^5..x^15
p = fpminimax(sin(x), [|5, 7, 9, 11, 13, 15|], [|D...|], I, relative, floating, x + c3 * x^3);
show("sin_f64", p, sin(x));

// f64 cosine: 1 - x^2/2 + x^4..x^14
p = fpminimax(cos(x), [|4, 6, 8, 10, 12, 14|], [|D...|], I, relative, floating, 1 - x^2/2);
show("cos_f64", p, cos(x));

// f32 sine, evaluated in double: x + x^3..x^9
p = fpminimax(sin(x), [|3, 5, 7, 9|], [|D...|], I, relative, floating, x);
show("sin_f32", p, sin(x));

// f32 cosine, evaluated in double: 1 + x^2..x^8
p = fpminimax(cos(x), [|2, 4, 6, 8|], [|D...|], I, relative, floating, 1);
show("cos_f32", p, cos(x));

quit;
